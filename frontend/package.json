{
  "name": "evaluation-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "效能评估系统 - 前端 (Vue 3 + TypeScript + Element Plus + ECharts)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
